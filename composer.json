{
    "name": "brasizza/azure-storage-blob",
    "description": "Community-maintained fork of microsoft/azure-storage-blob (retired by Microsoft in March 2024). Not affiliated with Microsoft.",
    "keywords": [
        "php",
        "azure",
        "storage",
        "sdk",
        "blob"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marcus Brasizza",
            "role": "Fork maintainer"
        },
        {
            "name": "Azure Storage PHP Client Library",
            "email": "dmsh@microsoft.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.1",
        "brasizza/azure-storage-common": "^1.6"
    },
    "replace": {
        "microsoft/azure-storage-blob": "self.version"
    },
    "autoload": {
        "psr-4": {
            "MicrosoftAzure\\Storage\\Blob\\": "src/Blob"
        }
    }
}
